{
  "name": "@n-uf/doodl-react",
  "version": "26.11.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "React bindings for @n-uf/doodl — canvas component, page annotation layer, and document annotation helpers.",
  "keywords": [
    "react",
    "canvas",
    "drawing",
    "annotation",
    "doodl"
  ],
  "license": "LicenseRef-PolyForm-Perimeter-1.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n-uf/doodl.git",
    "directory": "packages/doodl-react"
  },
  "homepage": "https://doodl.n-uf.com/",
  "bugs": {
    "url": "https://github.com/n-uf/doodl/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@n-uf/source": "./index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./tool-items": {
      "@n-uf/source": "./src/tool-items.ts",
      "types": "./dist/tool-items.d.ts",
      "import": "./dist/tool-items.mjs",
      "require": "./dist/tool-items.cjs"
    },
    "./styles/text-layer.css": {
      "@n-uf/source": "./src/styles/text-layer.css",
      "default": "./dist/text-layer.css"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup",
    "check": "pnpm typecheck && pnpm test",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@n-uf/doodl": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^26.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
