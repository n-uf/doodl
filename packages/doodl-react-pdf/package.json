{
  "name": "@n-uf/doodl-react-pdf",
  "version": "26.7.0",
  "private": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "description": "PDF annotation components and hooks for React, combining react-pdf with @n-uf/doodl.",
  "keywords": [
    "react",
    "pdf",
    "annotation",
    "react-pdf",
    "doodl"
  ],
  "license": "LicenseRef-PolyForm-Perimeter-1.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n-uf/doodl.git",
    "directory": "packages/doodl-react-pdf"
  },
  "homepage": "https://doodl.n-uf.com/",
  "bugs": {
    "url": "https://github.com/n-uf/doodl/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@n-uf/source": "./index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./components": {
      "@n-uf/source": "./src/components/index.ts",
      "types": "./dist/components.d.ts",
      "import": "./dist/components.mjs",
      "require": "./dist/components.cjs"
    },
    "./hooks": {
      "@n-uf/source": "./src/hooks/index.ts",
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.mjs",
      "require": "./dist/hooks.cjs"
    },
    "./types": {
      "@n-uf/source": "./src/types.ts",
      "types": "./dist/types.d.ts",
      "import": "./dist/types.mjs",
      "require": "./dist/types.cjs"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css",
    "**/pdf-annotation-page.tsx",
    "**/pdf-annotation-page.js",
    "**/pdf-annotation-page.mjs",
    "**/pdf-annotation-page.cjs"
  ],
  "scripts": {
    "build": "tsup",
    "check": "pnpm typecheck",
    "prepublishOnly": "pnpm build",
    "release": "if [ \"$npm_config_nobump\" = \"true\" ]; then pnpm publish --no-git-checks; else node ./scripts/calendar-version-bump.mjs --apply && pnpm publish --no-git-checks; fi",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "release:next-version": "node ./scripts/calendar-version-bump.mjs --dry-run"
  },
  "dependencies": {
    "@n-uf/doodl": "workspace:*",
    "@n-uf/doodl-react": "workspace:*"
  },
  "peerDependencies": {
    "pdfjs-dist": "^5.0.0",
    "react": "^19",
    "react-dom": "^19",
    "react-pdf": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "pdfjs-dist": "5.7.284",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-pdf": "^10.4.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
