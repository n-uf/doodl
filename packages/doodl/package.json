{
  "name": "@n-uf/doodl",
  "version": "26.7.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "Vanilla-first canvas drawing and annotation library with shape modules, hit-testing, and JSON serialization.",
  "keywords": [
    "canvas",
    "drawing",
    "annotation",
    "shapes",
    "freehand",
    "highlight",
    "redaction",
    "pdf-annotation",
    "vanilla-js"
  ],
  "license": "LicenseRef-PolyForm-Perimeter-1.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n-uf/doodl.git",
    "directory": "packages/doodl"
  },
  "homepage": "https://doodl.n-uf.com/",
  "bugs": {
    "url": "https://github.com/n-uf/doodl/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@n-uf/source": "./index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/index.mjs",
    "./dist/index.cjs",
    "./src/shapes/register-builtins.ts",
    "./src/shapes/*/module.ts"
  ],
  "scripts": {
    "build": "tsup",
    "check": "pnpm typecheck && pnpm test",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "jsdom": "^26.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
